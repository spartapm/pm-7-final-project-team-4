# Vercel Environment Variables에도 같은 이름으로 넣습니다.
# NEXT_PUBLIC_ 값은 빌드 시 클라이언트에 들어가므로, 시크릿/서비스롤은 넣지 마세요.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 카카오 로그인. JS 키는 SDK init, REST 키는 토큰 교환.
# NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key
# KAKAO_REST_API_KEY=your_kakao_rest_api_key
# KAKAO_CLIENT_SECRET=  # 콘솔에서 Client secret을 켰을 때만

# 테이블 생성(npm run db:schema)할 때만 필요. 앱 런타임에는 쓰지 않습니다.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres
